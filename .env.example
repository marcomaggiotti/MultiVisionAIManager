# Copy to .env next to docker-compose.yml.

# Source of the YOLO module (detect_image_engine). By default Docker builds it
# directly from GitHub (no clone needed). Uncomment to use a local checkout instead.
# YOLO_MODULE_SOURCE=../detect_image_engine

# Models loaded at start (all can be changed from the web interface).
YOLO_WEIGHTS=/models/yolo11n-pose.pt
CLIP_MODEL_ID=openai/clip-vit-base-patch16
VLM_MODEL_ID=HuggingFaceTB/SmolVLM-256M-Instruct
VLM_QUANTIZATION=none          # none | 8bit | 4bit

# Only for gated Hugging Face models.
HF_TOKEN=

# Ports on the host.
WEB_PORT=3000
MANAGER_PORT=8080
YOLO_PORT=8001
CLIP_PORT=8002
VLM_PORT=8003
