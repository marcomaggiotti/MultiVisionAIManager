# Copy to .env next to docker-compose.yml.

# Models loaded at start (all can be changed from the web interface).
YOLO_WEIGHTS=/models/yolo11n-pose.pt
CLIP_MODEL_ID=openai/clip-vit-base-patch16
VLM_MODEL_ID=HuggingFaceTB/SmolVLM-256M-Instruct
VLM_QUANTIZATION=none          # none | 8bit | 4bit

# Only for gated Hugging Face models.
HF_TOKEN=

# Ports on the host.
WEB_PORT=3000
WEB_HTTPS_PORT=3443          # for phones/tablets on the local network
# CERT_HOSTS=192.168.1.20      # this computer's LAN IP, written into the self-signed certificate
MANAGER_PORT=8080
YOLO_PORT=8001
CLIP_PORT=8002
VLM_PORT=8003

# Pictures of the analysed frames (and the analyses): in a database now, Azure later.
#   database: SQLite in the manager's data volume (default)
#   azure:    Azure Blob Storage. Build with MANAGER_PIP_EXTRAS=azure, set the connection
#             string, copy the pictures, then switch:
#             docker compose exec manager-api python -m app.media.picture_store migrate --to azure
MANAGER_PICTURE_STORE=database
MANAGER_PIP_EXTRAS=
MANAGER_AZURE_STORAGE_CONNECTION_STRING=
MANAGER_AZURE_STORAGE_CONTAINER=multivision-pictures

# Audio cleaning (modules/audio): auto = Claude when ANTHROPIC_API_KEY is set, else rule-based
AUDIO_CLEANING_AGENT=auto
AUDIO_PORT=8004
ANTHROPIC_API_KEY=
